# Used locally. Firebase App Hosting injects Firebase configuration automatically.
NEXT_PUBLIC_FIREBASE_API_KEY=REPLACE_ME
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=REPLACE_ME.firebaseapp.com
NEXT_PUBLIC_FIREBASE_PROJECT_ID=REPLACE_ME
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=REPLACE_ME.firebasestorage.app
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=REPLACE_ME
NEXT_PUBLIC_FIREBASE_APP_ID=REPLACE_ME

DEFAULT_EVENT_SLUG=dana

# At least 32 random characters. Never expose this as NEXT_PUBLIC_*.
SUBMISSION_HASH_SALT=REPLACE_WITH_A_LONG_RANDOM_SECRET

# Optional local Admin SDK credentials:
# Windows PowerShell:
# $env:GOOGLE_APPLICATION_CREDENTIALS="C:\secure\firebase-service-account.json"
# macOS/Linux:
# export GOOGLE_APPLICATION_CREDENTIALS="/secure/firebase-service-account.json"
