rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    function eventIsPublished(eventId) {
      return get(/databases/$(database)/documents/events/$(eventId)).data.isPublished == true;
    }

    match /events/{eventId} {
      allow read: if resource.data.isPublished == true;
      allow write: if false;

      match /publicMessages/{messageId} {
        allow read: if eventIsPublished(eventId);
        allow write: if false;
      }

      // Private submissions are only accessed by trusted server code.
      match /submissions/{messageId} {
        allow read, write: if false;
      }

      match /rateLimits/{fingerprint} {
        allow read, write: if false;
      }
    }

    // Admin authorization is checked server-side.
    match /admins/{uid} {
      allow read, write: if false;
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
